# Supabase (existing)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin gate for /admin/* and /api/admin/* — the single shared password.
# The session-signing key IS this value: rotating it invalidates every live
# session and changes the password in one move. Server-only; never NEXT_PUBLIC_.
ADMIN_PASSWORD=

# On-chain attestations (EAS on Base)
EAS_CHAIN=base                 # "base" (mainnet) | "base-sepolia"
BASE_RPC_URL=                  # JSON-RPC endpoint for the active chain
ATTESTER_PRIVATE_KEY=          # hot wallet that signs/pays (server-only)
EAS_SCHEMA_UID=                # server schema UID, printed by scripts/register-schema.ts
EAS_SKILL_SCHEMA_UID=          # skill schema UID, printed by scripts/register-schema.ts

# Hosted grading runner (for the admin Re-grade button → POST /grade)
HOSTED_RUNNER_URL=             # e.g. https://hosted.polygraph.so (server-only)
HOSTED_RUNNER_TOKEN=           # the runner's LITMUS_RUNS_TOKEN bearer (server-only)

# Ecosystem payments ($POLYGRAPH stream via Sablier on Base)
# The stream recipient. NEXT_PUBLIC on purpose: the client builds the create tx
# against the same address the server verifies against. Payments are disabled
# until this is set.
NEXT_PUBLIC_POLYGRAPH_TREASURY_ADDRESS=
# Optional overrides; defaults live in lib/paymentConfig.ts.
# NEXT_PUBLIC_POLYGRAPH_TOKEN_ADDRESS=
# NEXT_PUBLIC_SABLIER_LOCKUP_ADDRESS=

# Reown AppKit project id (dashboard.reown.com) — wallet modal on the activation page.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Optional payment-rail RPC override (Base MAINNET only — asserted at runtime).
# Do NOT point this at the EAS chain; defaults to https://mainnet.base.org.
# PAYMENT_RPC_URL=

# x402 grading-fee rail (USDC on Base, for agents) — Coinbase CDP facilitator
# keys (portal.cdp.coinbase.com). Without them /api/x402/grade-request 503s
# and callers fall back to the web checkout. Server-only.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Subscription-stopped notices (admin stop) — Resend. Server-only.
RESEND_API_KEY=
# ALERT_FROM_EMAIL=
