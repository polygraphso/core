# Polygraph environment.
#
# Copy this file to .env (already in .gitignore) and fill in values.
# All Supabase access is server-side — never add a NEXT_PUBLIC_ prefix to
# either of these. The anon key isn't wired up to the browser by design.

# Supabase — from dashboard → Project settings → API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required by the scoring loop's github adapter — it throws at call time
# if this is missing. Unauthed GitHub API caps at 60 req/hr, which silently
# breaks scoring runs at any reasonable seed size. A fine-grained PAT
# with public-repo read access is enough.
# Create at: https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=
