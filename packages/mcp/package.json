{
  "name": "@polygraphso/mcp",
  "version": "0.3.0",
  "description": "MCP server for polygraph.so — independent, lab-evaluated trust grades for MCP servers. Lets AI agents check the polygraph of a server before recommending or installing it.",
  "license": "Apache-2.0",
  "homepage": "https://polygraph.so",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polygraphso/core.git",
    "directory": "packages/mcp"
  },
  "bugs": "https://github.com/polygraphso/core/issues",
  "keywords": [
    "polygraph",
    "mcp",
    "model-context-protocol",
    "trust",
    "ai-agents",
    "mcp-server"
  ],
  "type": "module",
  "bin": {
    "polygraphso-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
