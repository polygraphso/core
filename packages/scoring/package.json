{
  "name": "@polygraph/scoring",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "node --env-file=../../.env --import tsx ./src/seed/seed.ts",
    "seed:ci": "node --import tsx ./src/seed/seed.ts",
    "probe": "node --env-file=../../.env --import tsx ./src/scripts/probe.ts",
    "score": "node --env-file=../../.env --import tsx ./src/scripts/score.ts",
    "score:ci": "node --import tsx ./src/scripts/score.ts",
    "top": "node --env-file=../../.env --import tsx ./src/scripts/top.ts",
    "catalog:sync": "node --env-file=../../.env --import tsx ./src/scripts/catalog-sync.ts",
    "catalog:backfill": "node --env-file=../../.env --import tsx ./src/scripts/catalog-sync.ts --backfill",
    "catalog:sync:ci": "node --import tsx ./src/scripts/catalog-sync.ts",
    "catalog:resolve": "node --env-file=../../.env --import tsx ./src/scripts/catalog-resolve.ts",
    "catalog:resolve:ci": "node --import tsx ./src/scripts/catalog-resolve.ts",
    "catalog:search": "node --env-file=../../.env --import tsx ./src/scripts/catalog-search.ts",
    "poll": "node --env-file=../../.env --import tsx ./src/scripts/poll.ts",
    "alerts": "node --env-file=../../.env --import tsx ./src/scripts/alerts.ts",
    "alerts:ci": "node --import tsx ./src/scripts/alerts.ts",
    "advisories": "node --env-file=../../.env --import tsx ./src/scripts/ingest-advisories.ts",
    "advisories:ci": "node --import tsx ./src/scripts/ingest-advisories.ts",
    "ecosystem-alerts": "node --env-file=../../.env --import tsx ./src/scripts/ecosystem-alerts.ts",
    "ecosystem-alerts:ci": "node --import tsx ./src/scripts/ecosystem-alerts.ts",
    "fulfill": "node --env-file=../../.env --import tsx ./src/scripts/fulfill-grade-requests.ts",
    "fulfill:ci": "node --import tsx ./src/scripts/fulfill-grade-requests.ts",
    "backfill:commit-anchor": "node --env-file=../../.env --import tsx ./src/scripts/backfill-commit-anchor.ts"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "dependencies": {
    "@polygraph/core": "workspace:*",
    "@supabase/supabase-js": "^2.45.0",
    "resend": "^4.0.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.0"
  }
}
